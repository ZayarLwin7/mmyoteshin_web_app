# =============================================================================
# MM YoteShin — environment configuration
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env.local
#
# Anything prefixed with NEXT_PUBLIC_ is embedded in the browser bundle.
# Never put a secret in a NEXT_PUBLIC_ variable.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Session-mode pooler connection string from Supabase → Project Settings → Database.
# Used by the application at runtime and by `pnpm db:migrate`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional. Direct (non-pooled) connection used for schema migrations.
# Falls back to DATABASE_URL when unset.
DIRECT_URL=""

# -----------------------------------------------------------------------------
# Admin session signing
# -----------------------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every active admin session.
SESSION_SECRET=""

# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# -----------------------------------------------------------------------------
# Site identity (public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="MM YoteShin"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DESCRIPTION="A curated catalogue of films with editorial reviews and clearly labelled, authorized distribution links."

# Comma-separated allowlist of hosts the Next.js image optimiser may fetch from.
# https only. Example: "https://images.example-cdn.com,https://cdn.example.org/posters"
NEXT_PUBLIC_IMAGE_HOSTS="https://images.unsplash.com,https://upload.wikimedia.org"

# Contact address shown on /contact and used for takedown notices.
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
# Address that receives copyright/takedown notices (see /copyright).
NEXT_PUBLIC_TAKEDOWN_EMAIL="takedown@example.com"

# -----------------------------------------------------------------------------
# Advertising
# -----------------------------------------------------------------------------
# Ads stay off until the network account and site are approved.
# See docs/content-operations.md before enabling.
NEXT_PUBLIC_ADS_ENABLED="false"
# Ad network client/slot identifiers. Leave blank while ads are disabled.
NEXT_PUBLIC_AD_CLIENT=""
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=""
NEXT_PUBLIC_AD_SLOT_INLINE=""

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# Privacy-conscious, cookieless page-view counting. Off by default.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
# Optional self-hosted or third-party endpoint. Leave blank to disable network calls.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Requests allowed per window, per client fingerprint.
RATE_LIMIT_AUTH_MAX="10"
RATE_LIMIT_AUTH_WINDOW_SECONDS="300"
RATE_LIMIT_REPORT_MAX="5"
RATE_LIMIT_REPORT_WINDOW_SECONDS="3600"
RATE_LIMIT_SEARCH_MAX="60"
RATE_LIMIT_SEARCH_WINDOW_SECONDS="60"

# -----------------------------------------------------------------------------
# Bootstrap / development only
# -----------------------------------------------------------------------------
# Used by `pnpm admin:create` when you prefer flags over prompts.
# Leave blank in production — pass flags or use the interactive prompt instead.
# All three must be set for the script to run non-interactively (e.g. in CI);
# any that is blank falls back to a prompt, which will block without a TTY.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Set to "1" to allow the destructive development seeder to run.
ALLOW_DEV_SEED="0"
